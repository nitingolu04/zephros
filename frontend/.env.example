# Frontend environment variables
# Copy to .env in project root (local) or set in Vercel → Settings → Environment Variables

# Firebase (required for Google sign-in)
# Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend URL
# Local: leave empty — Vite proxies /api and /socket.io to localhost:3001
# Production (Vercel): https://your-backend.onrender.com (no trailing slash)
VITE_API_URL=

# Optional — Google Drive upload for board recordings
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
VITE_GOOGLE_OAUTH_CLIENT_ID=
