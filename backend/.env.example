PORT=3001
MONGO_URI=mongodb://localhost:27017/aerix

# Comma-separated if you have preview + production frontends
# e.g. https://aerix.vercel.app,https://aerix-git-main-you.vercel.app
CLIENT_URL=http://localhost:5173

# Firebase Admin (required when frontend Firebase is enabled)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key as one line with \n for newlines (Render/Vercel env var format)
FIREBASE_PRIVATE_KEY=
